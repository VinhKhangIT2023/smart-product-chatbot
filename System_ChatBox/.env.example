# Copy file này thành .env rồi điền giá trị thật của bạn — KHÔNG commit file .env lên Git.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=klcn_chatbot

QWEN_API_KEY=your_openrouter_or_alibaba_api_key_here
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen3.8-27b:free

# Tuỳ chọn — có giá trị mặc định sẵn trong code, không bắt buộc khai báo
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
